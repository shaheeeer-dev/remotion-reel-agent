# ==============================================================================
# AI Social Media Manager — Environment Configuration (.env.example)
# Note: Keep all real secrets outside source control.
# ==============================================================================

# Runtime mode: development | staging | production
NODE_ENV=development

# Express API Port & URLs
API_PORT=4000
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reel_agent_db?schema=public"

# Redis & BullMQ
REDIS_URL="redis://localhost:6379"

# Session & Security
SESSION_SECRET="change-this-to-a-secure-random-32-byte-hex-string"
# Required for production API requests; do not expose this value in browser JavaScript
API_ADMIN_TOKEN=

# Gemini Free-Tier Configuration (confirm model access and quota in your AI Studio project)
GEMINI_API_KEY="your-gemini-free-tier-api-key"
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_MAX_REQUESTS_PER_DAY=100
# Optional visible repo attribution on generated video end cards (set after publishing repo)
REPO_CREDIT_URL=

# Instagram Graph API / Meta App Credentials
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"
META_GRAPH_API_VERSION="v21.0"
META_IG_USER_ID="your-instagram-business-user-id"
META_ACCESS_TOKEN=""

# Media Storage & Public Serving
PUBLIC_MEDIA_BASE_URL="http://localhost:4000/media"
MEDIA_STORAGE_DIR="./storage/media"
MEDIA_RETENTION_DAYS=30

# Scheduling & Workers
SCHEDULER_TIMEZONE="UTC"
DAILY_PUBLISH_TIME="14:00"
WORKER_CONCURRENCY=2
MAX_RENDER_SECONDS=180

