{
  "name": "remotion-reel-agent",
  "version": "1.0.0",
  "private": true,
  "description": "AI Social Media Manager for automated educational Instagram Reels",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@learnops/schema && npm run build --workspace=@learnops/renderer && npm run build --workspace=@learnops/api && npm run build --workspace=@learnops/dashboard",
    "dev:api": "npm --workspace=@learnops/api run dev",
    "dev:dashboard": "npm --workspace=@learnops/dashboard run dev",
    "setup:kokoro": "npm --workspace=@learnops/api run setup:kokoro:model",
    "prisma:generate": "npm --workspace=@learnops/api run prisma:generate",
    "prisma:seed": "npm --workspace=@learnops/api run seed",
    "knowledge:sync": "tsx scripts/sync-knowledge.ts",
    "topics:discover": "tsx scripts/discover-topics.ts",
    "test:7day": "tsx scripts/test-7day-autonomous-suite.ts"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "allowScripts": {
    "onnxruntime-node@1.21.0": true
  }
}
